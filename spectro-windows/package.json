{
  "name": "spectro",
  "productName": "Spectro",
  "version": "1.0.6",
  "description": "Spectro Music Desktop Player",
  "main": "main.js",
  "author": "Nazar Yosa",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NazarYosa/Spectro.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.spectro.desktop",
    "productName": "Spectro",
    "publish": {
      "provider": "github",
      "owner": "NazarYosa",
      "repo": "Spectro"
    },
    "win": {
      "icon": "dist/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spectro",
      "artifactName": "Spectro-Setup.${ext}",
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "Spectro.${ext}"
    },
    "directories": {
      "output": "release-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ]
  }
}
